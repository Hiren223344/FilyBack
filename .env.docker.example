# Copy to `.env` in this directory. docker compose auto-substitutes these.
# Generate each independently:  openssl rand -base64 48
JWT_SECRET=replace-me-with-48+-random-bytes
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48+-random-bytes
COOKIE_SECRET=replace-me-with-another-DIFFERENT-48+-random-bytes
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
