# Copy to `.env` in this directory. docker compose auto-substitutes these.
# Generate each independently:  openssl rand -base64 48
JWT_SECRET=replace-me-with-48+-random-bytes
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48+-random-bytes
COOKIE_SECRET=replace-me-with-another-DIFFERENT-48+-random-bytes
CORS_ORIGINS=https://filybase.io,https://www.filybase.io

# Public URLs for payment redirects + IPN callback
APP_URL=https://filybase.io
PUBLIC_API_URL=https://api.filybase.io

# NOWPayments — https://account.nowpayments.io  (Settings -> API keys, and Store -> IPN)
# Leave blank to disable paid top-ups (signup still grants the $5 trial credit).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
