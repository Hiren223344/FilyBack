# ==============================================================================
# FilyBase Inference Gateway Environment Configuration
# ==============================================================================

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://filybase:filybase_secret_pass@localhost:5432/filybase
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Cache & Distributed Limits (Redis 7)
REDIS_URL=redis://:redis_secret_pass@localhost:6379/0
REDIS_KEY_PREFIX=filybase:

# Security & Authentication
# Secrets MUST be high-entropy and >= 32 chars. When NODE_ENV=production the
# server REFUSES TO START if any of these still hold the sample values below,
# if JWT_SECRET == JWT_REFRESH_SECRET, or if CORS_ORIGINS contains "*".
# Generate each one independently, e.g.:  openssl rand -base64 48
JWT_SECRET=filybase_super_secret_jwt_key_at_least_32_chars_long_12345
JWT_REFRESH_SECRET=filybase_super_secret_refresh_jwt_key_32_chars_long_67890
COOKIE_SECRET=filybase_super_secret_cookie_signing_key_32_chars_long_abcde
# Comma-separated allow-list. The Next.js frontend proxies server-side, so in a
# standard deployment only add browser origins that call the gateway directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.filybase.com

# Admission Control & Queuing
# Maximum time (in milliseconds) a request will wait in the Redis concurrency queue before returning 429
QUEUE_WAIT_MS=10000
# Polling interval in ms while waiting for a concurrency slot
QUEUE_POLL_INTERVAL_MS=50

# Rate Limiting Defaults
DEFAULT_KEY_RPM=600
DEFAULT_PROJECT_TPM=500000

# Metering & Async Usage Event Buffering
USAGE_FLUSH_INTERVAL_MS=1000
USAGE_BATCH_SIZE=500
ROLLUP_REFRESH_INTERVAL_MS=60000

# Payload Size Limits
MAX_REQUEST_BODY_SIZE_BYTES=1048576
MAX_AUDIO_BODY_SIZE_BYTES=26214400

# Upstream Mock Engine (for dev/testing without local GPU)
MOCK_UPSTREAM_ENABLED=true
MOCK_UPSTREAM_PORT=8001
