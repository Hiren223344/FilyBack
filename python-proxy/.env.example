# Host/port the proxy + dashboard listen on
HOST=0.0.0.0
PORT=9000

# SQLite database file (created automatically)
DATABASE_PATH=./data/proxy.db

# Default system prompt prepended to EVERY request, regardless of model.
# Combined as: DEFAULT_SYSTEM_PROMPT + per-model system prompt + caller's own system prompt.
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Dashboard HTTP Basic Auth (protects the /  UI where provider API keys are managed)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# If set, callers of the proxy's /v1/* endpoints must send this as
# `Authorization: Bearer <PROXY_API_KEY>`. Leave blank to disable (not recommended).
PROXY_API_KEY=

# Anthropic API version header sent when proxying to an Anthropic-type provider.
ANTHROPIC_VERSION=2023-06-01
