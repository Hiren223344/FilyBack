{
  "name": "filybase-backend",
  "version": "1.0.0",
  "description": "FilyBase - Serverless-style high-throughput GPU inference gateway for open-weight models",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mock:upstream": "tsx src/mock-upstream/server.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "verify:sdk": "tsx scripts/verify-sdk.ts"
  },
  "keywords": [
    "filybase",
    "inference-gateway",
    "vllm",
    "fastify",
    "gpu",
    "openai-compatible",
    "serverless-ai"
  ],
  "author": "FilyBase Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "eventsource-parser": "^3.0.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "undici": "^7.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "openai": "^4.86.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
